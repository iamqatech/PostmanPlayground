                  "pm.test(\"Verify that response should contain newly created booking\", function () {",
                  "    const bookingIds = pm.response.json();",
                  "    const bookingId = parseInt(pm.collectionVariables.get(\"bookingId\"));",
                  "    const found = bookingIds.some(function(booking) {",
                  "        return booking.bookingid === bookingId;",
