              "mode": "raw",
              "raw": "{\n    \"username\": \"{{username}}\",\n    \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{url}}/auth",
              "host": [
                "{{url}}"
              ],
              "path": [
                "auth"
              ]
            }
          },
          "response": []
        }
