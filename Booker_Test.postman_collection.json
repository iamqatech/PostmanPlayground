  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "requests": {},
        "exec": [
          "function formatDate(date) {",
          "    const yyyy = date.getFullYear();",
          "    const mm = String(date.getMonth() + 1).padStart(2, '0');",
          "    const dd = String(date.getDate()).padStart(2, '0');",
          "    return `${yyyy}-${mm}-${dd}`;",
          "}",
          "",
          "const now = new Date();",
          "",
          "const currentDate = formatDate(now);",
          "",
          "const pastDateObj = new Date(now);",
          "pastDateObj.setDate(now.getDate() - 5);",
          "const pastDate = formatDate(pastDateObj);",
          "",
          "const futureDateObj = new Date(now);",
          "futureDateObj.setDate(now.getDate() + 5);",
          "const futureDate = formatDate(futureDateObj);",
          "",
          "pm.collectionVariables.set('currentDate', currentDate);",
          "pm.collectionVariables.set('pastDate', pastDate);",
          "pm.collectionVariables.set('futureDate', futureDate);"
        ]
      }
    },
