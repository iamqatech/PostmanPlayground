          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "",
                  "pm.test(\"Verify that token is present in the response\", function () {",
                  "    pm.expect(response.token).to.not.be.undefined;",
                  "});",
                  "",
                  "/**************** Token ********************* */",
                  "",
                  "if (pm.response.code === 200) {",
                  "    pm.environment.set(\"token\", response.token);",
                  "}",
                  "",
                  "else {",
                  "    console.error(\"Auth API is not working. Check the config.\")",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
