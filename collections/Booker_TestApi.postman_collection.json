        {
          "name": "deleteBooking",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Verify the delete request is successful\", function () {",
                  "    pm.expect(pm.response.code).to.eql(201);",
                  "});",
                  "",
                  "pm.test(\"Verify the delete response body is Created\", function () {",
                  "    pm.expect(pm.response.text()).to.eql(\"Created\");",
                  "});",
                  "",
                  "pm.test(\"Verify the booking is deleted successfully\", function (done) {",
                  "",
                  "    if (pm.response.code === 201) {",
                  "",
                  "        const getUrl =",
                  "            pm.environment.get(\"url\") +",
                  "            \"/booking/\" +",
                  "            pm.collectionVariables.get(\"bookingId\");",
                  "",
                  "        pm.sendRequest(getUrl, function (err, response) {",
                  "",
                  "            pm.expect(err).to.be.null;",
                  "",
                  "            pm.expect(response).to.not.be.undefined;",
                  "",
                  "            pm.expect(response.code).to.eql(404);",
                  "",
                  "            done();",
                  "        });",
                  "",
                  "    } else {",
                  "",
                  "        pm.expect.fail(",
                  "            \"Delete failed. Expected 201 but received \" +",
                  "            pm.response.code",
                  "        );",
                  "    }",
                  "});"
                ],
